						],
						"url": {
							"raw": "{{base_url}}/api/attendance/all?page=1&limit=10&userId=&startDate=&endDate=",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"attendance",
								"all"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "userId",
